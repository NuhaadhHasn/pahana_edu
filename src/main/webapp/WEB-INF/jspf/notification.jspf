<div class="modal fade" id="confirmDismissModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="confirmModalLabel">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="confirmModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmActionButton">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    /* global bootstrap */

    // --- GLOBAL SCOPE VARIABLES ---
    let confirmModal = null;
    const confirmModalElement = document.getElementById('confirmDismissModal');
    const confirmModalBody = document.getElementById('confirmModalBody');
    const confirmActionButton = document.getElementById('confirmActionButton');

    // --- GLOBAL FUNCTIONS (must be on window if called externally) ---
    window.showConfirmationModal = function (title, body, onConfirm) {
        if (confirmModal === null) {
            confirmModal = new bootstrap.Modal(confirmModalElement);
        }
        document.getElementById('confirmModalLabel').textContent = title;
        confirmModalBody.textContent = body;
        confirmActionButton.onclick = function () {
            try {
                if (typeof onConfirm === 'function') onConfirm();
            } finally {
                confirmModal.hide();
            }
        };
        confirmModal.show();
    };

    window.markAllAsRead = function () {
        fetch('${pageContext.request.contextPath}/api/notifications/mark-all-as-read', {method: 'POST'})
            .then(function (response) {
                if (response.ok) {
                    window.fetchAndRenderNotifications();
                } else {
                    alert('Could not mark all as read.');
                }
            });
    };

    // Make this global AND independent of inner scope
    window.markOneAsRead = function (notificationId, listItemElement) {
        var formData = new URLSearchParams();
        formData.append('id', notificationId);
        fetch('${pageContext.request.contextPath}/api/notifications/mark-as-read', {
            method: 'POST',
            body: formData
        })
            .then(function (response) {
                if (response.ok) {
                    if (listItemElement && listItemElement.parentNode) {
                        listItemElement.parentNode.removeChild(listItemElement);
                    }
                    window.updateNotificationCount();
                } else {
                    alert('Could not mark as read.');
                }
            });
    };

    // --- MAIN EXECUTION LOGIC ---
    (function () {
        var notificationBell = document.getElementById('notificationBell');
        if (!notificationBell) return;

        var notificationCountBadge = document.getElementById('notification-count');
        var notificationDropdown = document.getElementById('notification-dropdown');

        // Expose globally so markOneAsRead can call it
        window.updateNotificationCount = function () {
            var count = notificationDropdown.querySelectorAll('.notification-item').length;
            notificationCountBadge.textContent = String(count);
            notificationCountBadge.style.display = count > 0 ? 'block' : 'none';
        };

        // Make it global so others can call it
        window.fetchAndRenderNotifications = function () {
            fetch('${pageContext.request.contextPath}/api/dashboard-stats')
                .then(function (response) {
                    return response.json();
                })
                .then(function (data) {
                    // Clear dropdown
                    notificationDropdown.innerHTML = '';

                    // --- HEADER (static) ---
                    var headerLi = document.createElement('li');
                    var headerWrap = document.createElement('div');
                    headerWrap.className = 'px-3 py-2 d-flex justify-content-between align-items-center';

                    var titleSpan = document.createElement('span');
                    titleSpan.className = 'fw-bold';
                    titleSpan.textContent = 'Notifications';

                    var markAllBtn = document.createElement('button');
                    markAllBtn.type = 'button';
                    markAllBtn.className = 'btn btn-sm btn-outline-primary';
                    markAllBtn.textContent = 'Mark all as read';
                    markAllBtn.addEventListener('click', function () {
                        showConfirmationModal('Confirm Mark All', 'Are you sure?', window.markAllAsRead);
                    });

                    headerWrap.appendChild(titleSpan);
                    headerWrap.appendChild(markAllBtn);
                    headerLi.appendChild(headerWrap);
                    notificationDropdown.appendChild(headerLi);

                    // Divider after header
                    var dividerTop = document.createElement('li');
                    dividerTop.innerHTML = '<hr class="dropdown-divider my-1">';
                    notificationDropdown.appendChild(dividerTop);

                    var notifications = (data && data.notifications) ? data.notifications : [];

                    // --- SCROLLABLE NOTIFICATIONS CONTAINER ---
                    var notificationsContainerLi = document.createElement('li');
                    var notificationsContainer = document.createElement('div');
                    notificationsContainer.className = 'notification-list-container';
                    notificationsContainer.style.maxHeight = '290px'; // adjust height as needed
                    notificationsContainer.style.overflowY = 'auto';
                    notificationsContainer.style.overflowX = 'hidden';
                    notificationsContainer.style.padding = '0 0.5rem';
                    notificationsContainerLi.appendChild(notificationsContainer);
                    notificationDropdown.appendChild(notificationsContainerLi);

                    if (notifications.length > 0) {
                        notifications.forEach(function (notification) {
                            var li = document.createElement('div'); // use div for flex wrapping
                            li.className = 'notification-item d-flex w-100 justify-content-between align-items-start mb-1';

                            var info = document.createElement('div');
                            info.className = 'me-3 text-break';
                            info.style.flex = '1 1 auto';
                            info.style.minWidth = '0';
                            info.style.wordBreak = 'break-word';
                            info.style.overflowWrap = 'break-word';
                            info.style.whiteSpace = 'normal';

                            var titleDiv = document.createElement('div');
                            titleDiv.className = 'fw-bold';
                            titleDiv.textContent = notification.title || 'Low Stock Alert';

                            var msgDiv = document.createElement('div');
                            msgDiv.className = 'text-break';
                            msgDiv.textContent = notification.message || '';

                            info.appendChild(titleDiv);
                            info.appendChild(msgDiv);

                            var btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'btn btn-sm btn-outline-secondary flex-shrink-0';
                            btn.style.flexShrink = '0';
                            btn.textContent = 'Mark as Read';
                            btn.addEventListener('click', function () {
                                showConfirmationModal('Confirm Dismissal', 'Dismiss this notification?', function () {
                                    var nid = notification.notificationId != null ? notification.notificationId : notification.id;
                                    window.markOneAsRead(nid, li);
                                });
                            });

                            li.appendChild(info);
                            li.appendChild(btn);
                            notificationsContainer.appendChild(li);
                        });
                    } else {
                        var emptyDiv = document.createElement('div');
                        emptyDiv.className = 'text-center text-muted py-2';
                        emptyDiv.textContent = 'No new notifications.';
                        notificationsContainer.appendChild(emptyDiv);
                    }

                    // --- FOOTER (static) ---
                    var dividerBottom = document.createElement('li');
                    dividerBottom.innerHTML = '<hr class="dropdown-divider my-1">';
                    notificationDropdown.appendChild(dividerBottom);

                    var viewAllLi = document.createElement('li');
                    var viewAllLink = document.createElement('a');
                    viewAllLink.className = 'dropdown-item text-center text-info';
                    viewAllLink.href = '${pageContext.request.contextPath}/notifications';
                    viewAllLink.textContent = 'View All Notifications';
                    viewAllLi.appendChild(viewAllLink);
                    notificationDropdown.appendChild(viewAllLi);

                    window.updateNotificationCount();
                })
                .catch(function (error) {
                    console.error('Error fetching notifications:', error);
                });
        };


        // Initial load
        window.fetchAndRenderNotifications();
    })();
</script>

